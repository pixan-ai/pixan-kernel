# Copy to .env (never commit it). Readable only by the agent's Windows account.
CLIENT_IMAGE=ghcr.io/your-org/your-agent@sha256:REPLACE
AGENT_NAME=agent
AGENT_LANGUAGE=English
# Your own credential, one of these. API key recommended; if both are set the key wins.
ANTHROPIC_API_KEY=
# Subscription token (claude setup-token), for your own individual use only. See README "Auth model".
# CLAUDE_CODE_OAUTH_TOKEN=
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
KERNEL_FIREWALL=1
# Space separated. Add internal systems the agent may reach, e.g. an on-prem ERP.
KERNEL_EGRESS_ALLOW=
KERNEL_EGRESS_ALLOW_CIDR=
PIXAN_ADVISOR_MODEL=
