# Copy to .env (never commit it). Readable only by the agent's Windows account.
CLIENT_IMAGE=ghcr.io/your-org/your-agent@sha256:REPLACE
AGENT_NAME=agent
AGENT_LANGUAGE=English
# Your own credential, one of these. API key recommended; if both are set the key wins.
ANTHROPIC_API_KEY=
# Subscription token (claude setup-token), for your own individual use only. See README "Auth model".
# CLAUDE_CODE_OAUTH_TOKEN=
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
KERNEL_FIREWALL=1
# Space separated. Add internal systems the agent may reach, e.g. an on-prem ERP.
KERNEL_EGRESS_ALLOW=
KERNEL_EGRESS_ALLOW_CIDR=
PIXAN_ADVISOR_MODEL=
# Hourly encrypted backup: your age PUBLIC key (age-keygen -y key.txt). Keep key.txt off this machine.
BACKUP_AGE_RECIPIENT=
BACKUP_DIR=/backups
# Optional Cloudflare R2 copy (all four or none); a token scoped to one bucket.
BACKUP_R2_ENDPOINT=
BACKUP_R2_BUCKET=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# Fresh conversation after N idle minutes (0 = off) and/or daily at this hour (0-23).
SESSION_RESET_IDLE_MIN=0
SESSION_RESET_HOUR=
QUEUE_ALERT_SEC=900
